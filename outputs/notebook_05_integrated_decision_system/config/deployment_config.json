  "monitoring_rules": [
    {
      "rule_id": "market_data_completeness",
      "metric": "rolling_7d_complete_market_hour_share",
      "comparison": ">=",
      "threshold": 0.99,
      "action_on_failure": "fallback_to_point_and_alert",
      "severity": "critical"
    },
    {
      "rule_id": "commercial_delta",
      "metric": "rolling_28d_commercial_delta_vs_point_eur_per_mwh",
      "comparison": ">=",
      "threshold": 0.0,
      "action_on_failure": "fallback_to_point_and_review",
      "severity": "critical"
    },
    {
      "rule_id": "imbalance_increase",
      "metric": "rolling_28d_absolute_imbalance_increase_vs_point_pct",
      "comparison": "<=",
      "threshold": 50.0,
      "action_on_failure": "reduce_risk_mode_or_fallback",
      "severity": "high"
    },
    {
      "rule_id": "selected_quantile_lower_bound",
      "metric": "selected_nomination_quantile",
      "comparison": ">=",
      "threshold": 0.1,
      "action_on_failure": "clip_or_fallback_to_point",
      "severity": "high"
    },
    {
      "rule_id": "selected_quantile_upper_bound",
      "metric": "selected_nomination_quantile",
      "comparison": "<=",
      "threshold": 0.9,
      "action_on_failure": "clip_or_fallback_to_point",
      "severity": "high"
    },
    {
      "rule_id": "scenario_availability",
      "metric": "required_scenario_quantiles_available",
      "comparison": "==",
      "threshold": 1.0,
      "action_on_failure": "fallback_to_point_and_alert",
      "severity": "critical"
    },
    {
      "rule_id": "forecast_origin_integrity",
      "metric": "forecast_origin_before_gate_closure",
      "comparison": "==",
      "threshold": 1.0,
      "action_on_failure": "block_nomination_and_alert",
      "severity": "critical"
    }
  ],
  "fallback_hierarchy": [
    {
      "priority": 1,
      "policy": "active_operating_mode_policy",
      "condition": "all critical checks pass"
    },
    {
      "priority": 2,
      "policy": "same_panel_point_centre",
      "condition": "active policy unavailable or monitoring gate fails"
    },
    {
      "priority": 3,
      "policy": "last_valid_point_centre",
      "condition": "current point forecast unavailable; must carry stale-data flag"
    },
    {
      "priority": 4,
      "policy": "manual_trader_intervention",
      "condition": "no validated automated nomination exists"
    }
  ]
}